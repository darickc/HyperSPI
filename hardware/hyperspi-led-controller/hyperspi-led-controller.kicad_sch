	(text "GPIO16 HIGH -> Q2 on -> Q1 gate low -> LED power ON.\nR4/R7 keep Q1 OFF while the ESP32 boots (GPIO16 floats).\nFirmware: -DLED_POWER_PIN=16, no -DLED_POWER_INVERT.\nQ1: logic-level P-MOSFET, Vds >= 20V, Rds(on) <= 10 mOhm\nat Vgs = -4.5V. Add a TO-220 heatsink above ~10A."
		(exclude_from_sim no)
		(at 139.7 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid c5715c0e-6e61-5bb4-8f68-24890d09b927)
	)
